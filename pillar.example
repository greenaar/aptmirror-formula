# Complete aptmirror formula pillar example.
# The timer is disabled here to prevent accidental large downloads.
aptmirror:
  lookup:
    script: /usr/local/bin/apt-mirror
    config: /etc/apt-mirror/mirror.list
    config_dir: /etc/apt-mirror
    service_unit: /etc/systemd/system/apt-mirror-sync.service
    timer_unit: /etc/systemd/system/apt-mirror-sync.timer
    timer_service: apt-mirror-sync.timer

  distribution_package: apt-mirror
  remove_distribution_package: true
  dependency_packages:
    - perl
    - wget
    - ca-certificates
    - dpkg
    - coreutils
    - gzip
    - bzip2
    - xz-utils
    - zstd

  user:
    name: apt-mirror
    group: apt-mirror
    shell: /usr/sbin/nologin

  paths:
    base: /var/spool/apt-mirror
    mirror: /var/spool/apt-mirror/mirror
    skel: /var/spool/apt-mirror/skel
    var: /var/spool/apt-mirror/var
    clean_script: /var/spool/apt-mirror/var/clean.sh
    postmirror_script: /var/spool/apt-mirror/var/postmirror.sh

  settings:
    # null uses the minion's osarch grain.
    defaultarch: null
    nthreads: 20
    # Empty means unlimited; wget also accepts values such as 20m.
    limit_rate: ''
    retries: 5
    connect_timeout: 20
    read_timeout: 120
    contents: true
    # Include debian-installer/udeb indexes and packages.
    installer: false
    # Desktop software metadata and command-not-found indexes.
    dep11: true
    command_not_found: true
    # Comma-separated language names, "all", or "none".
    translations: en
    autoclean: false
    tilde: false
    allow_insecure: false
    verify_hashes: true
    require_sha256: true
    auth_no_challenge: false
    no_check_certificate: false
    unlink: false
    use_proxy: false
    http_proxy: ''
    https_proxy: ''
    proxy_user: ''
    proxy_password: ''
    # Optional mutual-TLS wget settings:
    certificate: ''
    private_key: ''
    ca_certificate: ''

  mirrors:
    - name: Debian 13 archive
      uri: https://deb.debian.org/debian
      suites:
        - trixie
        - trixie-updates
      components:
        - main
        - contrib
        - non-free
        - non-free-firmware
      architectures:
        - amd64
        - arm64
      sources: false
      clean: true

    - name: Debian 13 security
      uri: https://security.debian.org/debian-security
      suites:
        - trixie-security
      components:
        - main
        - contrib
        - non-free-firmware
      architectures:
        - amd64
        - arm64
      sources: false
      clean: true

    - name: Ubuntu 24.04 archive
      uri: https://archive.ubuntu.com/ubuntu
      suites:
        - noble
        - noble-updates
        - noble-backports
      components:
        - main
        - restricted
        - universe
        - multiverse
      architectures:
        - amd64
      sources: false
      clean: true

    - name: Ubuntu 24.04 security
      uri: https://security.ubuntu.com/ubuntu
      suites:
        - noble-security
      components:
        - main
        - restricted
        - universe
        - multiverse
      architectures:
        - amd64
      sources: false
      clean: true

  # Protect repository roots from cleanup even if they are otherwise selected.
  skip_clean: []
  # Escape hatch for flat or unusual vendor repositories in native syntax.
  raw_lines: []
  # Example:
  # raw_lines:
  #   - 'deb [arch=amd64] https://packages.example.com/debian stable main'
  #   - 'clean https://packages.example.com/debian'

  postmirror:
    enabled: false
    source: null
    contents: null
    contents_pillar: null
    template: jinja
    context: {}
    # Example fileserver script:
    # enabled: true
    # source: salt://site/aptmirror/postmirror.sh.jinja
    # context:
    #   publish_root: /srv/www/apt
    # Alternatively use contents or contents_pillar.

  schedule:
    enabled: false
    on_calendar: '*-*-* 03:00:00'
    randomized_delay: 30m
    persistent: true
    nice: 10
    io_class: best-effort
    io_priority: 7
    extra_read_write_paths: []
    # Add post-mirror publication destinations outside paths:base:
    # extra_read_write_paths:
    #   - /srv/www/apt
